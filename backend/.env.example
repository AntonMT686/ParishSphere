# ---- ParishSphere backend configuration (copy to .env) ----
PS_ENV=development
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
PS_SECRET_KEY=change-me-dev-only-secret-key-please-rotate-0000000000
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PS_SECRET_ENCRYPTION_KEY=
PS_MASTER_DATABASE_URL=mysql+pymysql://ps_admin:ps_admin@localhost:3306/ps_master?charset=utf8mb4
PS_TENANT_DB_DRIVER=mysql
PS_TENANT_DB_HOST=localhost
PS_TENANT_DB_PORT=3306
PS_TENANT_DB_ADMIN_USER=ps_admin
PS_TENANT_DB_ADMIN_PASSWORD=ps_admin
PS_TENANT_DB_SHARED_CREDENTIALS=true
PS_BASE_DOMAIN=parishsphere.localhost
PS_REDIS_URL=redis://localhost:6379/0
PS_CORS_ORIGINS=["http://localhost:5173"]
PS_EXPOSE_DOCS=true
# Email (MailHog in development: PS_SMTP_HOST=localhost, PS_SMTP_PORT=1025). Empty host = emails are only logged.
PS_SMTP_HOST=
PS_SMTP_PORT=1025
PS_APP_URL_TEMPLATE=http://{subdomain}.parishsphere.localhost
# File storage: local (default, ./data/files) or s3 (any S3-compatible service)
PS_STORAGE_BACKEND=local
# PS_S3_ENDPOINT_URL=http://localhost:9000
# PS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# PS_S3_BUCKET=parishsphere
# PS_S3_ACCESS_KEY=parishsphere
# PS_S3_SECRET_KEY=parishsphere-dev
# PS_S3_AUTO_CREATE_BUCKET=true
# Notifications: deliver via Celery when PS_REDIS_URL is set (override with PS_NOTIFICATIONS_ASYNC=true/false)
