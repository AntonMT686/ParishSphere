# ---- ParishSphere backend configuration (copy to .env) ----
PS_ENV=development
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
PS_SECRET_KEY=change-me-dev-only-secret-key-please-rotate-0000000000
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PS_SECRET_ENCRYPTION_KEY=
PS_MASTER_DATABASE_URL=mysql+pymysql://ps_admin:ps_admin@localhost:3306/ps_master?charset=utf8mb4
PS_TENANT_DB_DRIVER=mysql
PS_TENANT_DB_HOST=localhost
PS_TENANT_DB_PORT=3306
PS_TENANT_DB_ADMIN_USER=ps_admin
PS_TENANT_DB_ADMIN_PASSWORD=ps_admin
PS_TENANT_DB_SHARED_CREDENTIALS=true
PS_BASE_DOMAIN=parishsphere.localhost
PS_REDIS_URL=redis://localhost:6379/0
PS_CORS_ORIGINS=["http://localhost:5173"]
PS_EXPOSE_DOCS=true
