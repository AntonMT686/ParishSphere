# ---- ParishSphere production settings ----------------------------------------------------------
# Copy to infra/.env, replace every CHANGE-ME, and keep the file private (chmod 600).
# Random secrets:   openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
# Fernet key:       python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# Your domain. Each parish is served at <subdomain>.<PS_DOMAIN>, e.g. stmarys.parishsphere.example.org
PS_DOMAIN=parishsphere.example.org
# https (certificates in infra/certs) or http (trial install, or TLS terminated by another proxy)
PS_NGINX_TEMPLATE=https

# ---- database (internal network only) ----
MYSQL_ROOT_PASSWORD=CHANGE-ME-root
PS_DB_ADMIN_PASSWORD=CHANGE-ME-dbadmin

# ---- application ----
PS_ENV=production
PS_SECRET_KEY=CHANGE-ME-at-least-32-random-characters
PS_SECRET_ENCRYPTION_KEY=CHANGE-ME-fernet-key
PS_LOG_JSON=true
PS_LOG_LEVEL=INFO
# API worker processes per api container (about one per CPU core)
WEB_CONCURRENCY=2
# Behind another TLS proxy with PS_NGINX_TEMPLATE=http, keep cookies secure:
# PS_COOKIE_SECURE=true

# ---- email (password resets, approvals, notices); empty host = emails are only logged ----
PS_SMTP_HOST=smtp.example.org
PS_SMTP_PORT=587
PS_SMTP_USERNAME=CHANGE-ME
PS_SMTP_PASSWORD=CHANGE-ME
PS_SMTP_STARTTLS=true
PS_EMAIL_FROM=ParishSphere <no-reply@parishsphere.example.org>

# ---- files: a local Docker volume (default) or any S3-compatible service ----
PS_STORAGE_BACKEND=local
# PS_STORAGE_BACKEND=s3
# PS_S3_ENDPOINT_URL=https://s3.example.org
# PS_S3_BUCKET=parishsphere
# PS_S3_ACCESS_KEY=CHANGE-ME
# PS_S3_SECRET_KEY=CHANGE-ME
